{
  "name": "ai-roast-battle-functions",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "scripts": {
    "lint": "node --check index.js",
    "test:unit": "node --test index.test.js",
    "test:rules": "firebase emulators:exec --project demo-ai-roast-battle --only firestore,storage \"node --test rules.test.js\"",
    "test": "npm run test:unit",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^12.1.1",
    "firebase-functions": "^5.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^14.5.2"
  }
}
